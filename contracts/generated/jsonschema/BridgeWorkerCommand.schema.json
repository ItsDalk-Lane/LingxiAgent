{
  "$defs": {
    "BridgeEffectOperation": {
      "enum": [
        "receipt_start",
        "receipt_stop",
        "stream_update",
        "stream_finish",
        "stream_cancel"
      ],
      "type": "string"
    },
    "BridgeEffectRequest": {
      "additionalProperties": false,
      "properties": {
        "conversationId": {
          "type": "string"
        },
        "deliveryId": {
          "type": [
            "string",
            "null"
          ]
        },
        "effectId": {
          "type": "string"
        },
        "inboxId": {
          "type": "string"
        },
        "operation": {
          "$ref": "#/$defs/BridgeEffectOperation"
        },
        "replyContext": {
          "$ref": "#/$defs/BridgeReplyContext"
        },
        "rich": {
          "type": "boolean"
        },
        "runId": {
          "type": "string"
        },
        "sequence": {
          "format": "uint32",
          "maximum": 4294967295,
          "minimum": 1,
          "type": "integer"
        },
        "streamId": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
