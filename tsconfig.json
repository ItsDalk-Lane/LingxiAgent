{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@/*": ["desktop/src/react/*"]
    }
  },
  "include": [
    "desktop/src/**/*.ts",
    "desktop/src/**/*.tsx",
    "packages/*/src/**/*.ts",
    "packages/*/src/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "desktop/dist-renderer"
  ]
}
