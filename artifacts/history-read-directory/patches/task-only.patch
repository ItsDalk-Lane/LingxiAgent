+    label: req.label,
+    mode,
+    ok,
+    shaMatch: runs.every((run) => run.shaMatch),
+    fieldDiffs: bad.fieldDiffs,
+    fileUnchanged: runs.every((run) => run.fileUnchanged),
+    sha256Normalized: bad.sha256Normalized,
