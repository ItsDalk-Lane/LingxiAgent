+    getState: () => mockState,
+    setState: (patch: MockState | ((s: MockState) => MockState)) => {
+      const next = typeof patch === 'function' ? patch(mockState) : patch;
+      Object.assign(mockState, next);
+    },
+  },
+}));
+
+vi.mock('../hooks/use-hana-fetch', () => ({
+  lingxiFetch: mockFetch,
+  lingxiUrl: (p: string) => p,
