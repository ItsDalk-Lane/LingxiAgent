+          `[${tag}] mode=${mode} n=${n} ${req.label}: sha=${result.shaMatch ? "=" : "≠"} fields=${result.fieldDiffs.length === 0 ? "=" : "≠"} ` +
+            `fileUnchanged=${result.fileUnchanged} sha256Normalized=${result.sha256Normalized.slice(0, 12)}…`,
