+    });
+    expect(outcome.kind).toBe('ok'); // 无记录 → 无条件请求一次（有限）
+    expect(mockFetch).toHaveBeenCalledTimes(1);
+  });
+});
+
+function sessionUrl50(): string {
+  return '/api/sessions/messages?path=' + encodeURIComponent(sessionPath) + '&limit=50';
+}
