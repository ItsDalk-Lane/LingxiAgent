+    saveHistoryValidationRecord(sessionPath, {
+      url: sessionUrl50(), sessionPath, sessionId, limit: 50,
+      appliedLiveVersion: 0, etag: 'W/"hrp1-f03"', protocolHeader: '1',
+      data: pageBody(), todosVersion: 0,
+    });
