+function normalizeValue(value, tmpRoot, ctx, at) {
+  if (typeof value === "string") {
+    let v = value;
+    if (tmpRoot) v = v.split(tmpRoot).join("<TMPROOT>");
+    if (UUID_RE.test(v)) {
