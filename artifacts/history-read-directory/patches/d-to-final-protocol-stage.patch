+  if (!directory) {
+    const lease = await cache.beginBuild(key);
+    if (!lease) return overviewUnavailable("directory_unavailable"); // 超预算 no-cache（B04）
+    try {
+      const scan = await scanHistoryFile(input.sessionPath, { capturedLength: ctx.fileIdentity.size });
