+    throw new Error(`lingxiFetch ${input.url}: ${statusOf(res)}`);
+  }
+  noteCapabilityFromResponse(res, epoch);
+  return { kind: 'ok', response: res, etag: headerGet(res, 'etag'), requestKey, conditionalTried: true };
+}
