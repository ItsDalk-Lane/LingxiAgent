++interface DirectoryAttempt {
++  kind: "ok" | "fail" | "unavailable";
++  reason?: InvalidationReason;
++  message?: string;
++  result?: RoutePageResult;
++  revision?: string | null;
++  buildCount?: number;
++  fromCache?: boolean;
++}
