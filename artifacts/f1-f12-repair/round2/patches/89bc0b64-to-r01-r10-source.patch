+}
+
+export interface PageProjectorInput {
+  /**
+   * 记录视图：get(sourceIndex) → 原始投影消息（缺失返回 null/undefined）。
+   * 全量路径 = identityRecordView(sourceMessages)；热页 = 窗口∪闭包读取结果的
+   * Map 视图（稀疏、不重新编号，I02）。deferred 凭证经 createHistoryDeferredContentFor
