++/** 泛化二分：升序序列中第一个 key(item) >= value 的下标（数组/RecordList 均可）。 */
++function lowerBoundBy<T>(arr: { length: number; at(index: number): T }, value: number, key: (item: T) => number): number {
++  let lo = 0;
++  let hi = arr.length;
++  while (lo < hi) {
++    const mid = (lo + hi) >> 1;
++    if (key(arr.at(mid) as T) < value) lo = mid + 1;
