+}
+
+export function isBridgeSessionPath(sessionPath) {
+  if (typeof sessionPath !== "string" || !sessionPath) return false;
+  return sessionPath.split(/[\\/]+/).includes("bridge");
+}
+
+export function createSanitizeVisibleContent(sessionPath) {
