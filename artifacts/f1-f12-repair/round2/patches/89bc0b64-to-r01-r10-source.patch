+    expect(response.reconciliation.complete).toBe(true);
+    expect(response.messages.some((message: any) => message.clientMessageId)).toBe(false);
+  });
+
+  it('R04-08 当前分支不含原 user 或关联时不泄漏废弃分支证据', async () => {
