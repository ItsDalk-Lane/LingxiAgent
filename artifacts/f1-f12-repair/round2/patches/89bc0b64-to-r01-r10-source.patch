++export type InvalidationReason =
++  | "revision_unknown"
++  | "file_identity_changed"
++  | "branch_changed"
++  | "locator_changed"
++  | "untrusted_mutation"
++  | "directory_invalid"
++  | "short_read"
++  | "tail_incomplete"
++  | "budget_exceeded"
++  | "legacy_fallback"
++  | "snapshot_changed";
