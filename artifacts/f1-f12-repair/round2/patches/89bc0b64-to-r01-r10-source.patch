+function makeBundle(sessionPath: string, text: string, overrides: Partial<ComposerSendBundle> = {}): ComposerSendBundle {
+  return {
+    type: 'prompt',
+    sessionRef: { sessionId: `sess-${sessionPath}`, sessionPath, agentId: 'hana' },
+    text,
+    skills: [],
