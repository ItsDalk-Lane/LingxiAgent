++  // ② 窗口命中的 deferred-result interlude 锚点（§5 #7）：锚点 afterIndex 落在窗口内、
++  //    而该 deferred-result 记录自身可能在页外——补定位之。
++  for (const anchor of directory.assoc.deferredInterludeAnchors) {
