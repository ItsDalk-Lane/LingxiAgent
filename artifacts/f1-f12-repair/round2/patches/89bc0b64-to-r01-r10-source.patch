+  return {
+    messages: messagesOf(full).filter((m: any) => Number(m.id) >= start && Number(m.id) < end),
+    blocks: (full.blocks ?? []).filter((b: any) => b.afterIndex >= start && b.afterIndex < end)
+      .map((b: any) => ({ ...b, afterIndex: b.afterIndex - start })),
+  };
