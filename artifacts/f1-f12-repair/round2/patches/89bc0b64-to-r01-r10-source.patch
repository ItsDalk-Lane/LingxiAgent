+    expect(fs.readdirSync(path.join(f.dir, 'memory'))).toEqual([]);
+  });
+
+  it('R02-16 提交后出现后续用户新增，同批准重试保留新增而不整体恢复旧备份', () => {
+    const f = setup(); const a = approval(f.home); interrupt(f.home, a);
