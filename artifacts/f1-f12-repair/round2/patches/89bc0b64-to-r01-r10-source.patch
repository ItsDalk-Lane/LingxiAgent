++  const total = directory.session.displayTotal;
++  let startIdx: number;
++  let endIdx: number;
++  let hasMore: boolean;
++  if (params.forceAll) {
++    startIdx = 0;
++    endIdx = total;
++    hasMore = false;
++  } else {
++    endIdx = (params.beforeId != null && Number.isFinite(params.beforeId) && params.beforeId >= 0)
++      ? Math.min(params.beforeId, total)
