+
+function seedStore(sessionPaths: string[]) {
+  useStore.setState({
+    currentSessionPath: sessionPaths[0] ?? null,
+    currentSessionId: sessionPaths[0] ? `sess-${sessionPaths[0]}` : null,
+    currentAgentId: 'hana',
