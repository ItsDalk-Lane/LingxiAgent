+        result.physical.forEach((phys: any, i: number) => {
+          expect(phys.physicalIndex).toBe(i);
+          expect(phys.byteOffset).toBe(offsets[i]);
+          expect(phys.byteLength).toBe(Buffer.byteLength(LINES[i], "utf8"));
