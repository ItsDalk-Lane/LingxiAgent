+    const id = entry?.id;
+    if (typeof id !== "string" || !id) continue;
+    if (deltaIds.has(id) || oldDir.file.byEntryId.has(id)) {
+      return { kind: "fail", reason: "directory_invalid", detail: "session_branch_duplicate_id" };
+    }
+    deltaIds.add(id);
+  }
