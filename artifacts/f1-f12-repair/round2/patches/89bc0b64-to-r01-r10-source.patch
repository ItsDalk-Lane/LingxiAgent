++// - 仓库应用代码（core/lib/server/shared/hub）中少量具名导入
++const FS_NAMED_PARENT_MARKERS = [
++  `${path.sep}@earendil-works${path.sep}pi-coding-agent${path.sep}dist${path.sep}`,
++  `${path.sep}core${path.sep}`,
++  `${path.sep}lib${path.sep}`,
