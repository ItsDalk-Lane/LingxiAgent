+}
+
+function identityOf(sessionPath: string): ComposerSessionIdentity {
+  return { kind: 'session', sessionId: `sess-${sessionPath}`, sessionPath, agentId: 'hana' };
+}
+
+function seedStore(sessionPaths: string[]) {
+  useStore.setState({
