+///   full_original_behavior 与 r02_share_satisfied 不再拦截。
+#[derive(Debug, Clone, PartialEq)]
+pub struct LeafRollUp {
+    pub status: String,
+    pub reason: String,
+    pub assertion_results: Vec<Value>,
+    pub deferred_case_results: Vec<Value>,
+    /// 递延叶的提前实现命令健康观察（非门禁）。
+    pub early_evidence: Option<Value>,
