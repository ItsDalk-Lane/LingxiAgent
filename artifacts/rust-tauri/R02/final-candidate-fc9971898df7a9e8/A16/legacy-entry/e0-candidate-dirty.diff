+/// Outcomes helper: one passing and (optionally) one failing command.
+fn outcome(key: &str, exit: i32) -> crate::verify::CommandOutcome {
+    crate::verify::CommandOutcome {
+        key: key.to_string(),
+        exit_code: Some(exit),
+        timed_out: false,
+        internal_error: None,
+        evidence_missing: Vec::new(),
+        evidence_preexisting: Vec::new(),
+        cleanup: None,
     }
 }
