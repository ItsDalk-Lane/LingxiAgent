+  end try
+  set frontmost of p to true
+  set n to 0
+  repeat until (frontmost of p) or n > 16
+    delay 0.25
+    set n to n + 1
+  end repeat
+  if not (frontmost of p) then error "frontmost-not-achieved"
+  return name of p
+end tell`;
+  return osascript(script);
+}
