+        const draft = turnFor(string(row.runId, 'runId'), index);
+        draft.turnStatus = LEGACY_TURN_STATUS[status] ?? status;
+        draft.hasTerminal = true;
+        if (draft.final === undefined) draft.anchorIndex = index;
+        break;
+      }
