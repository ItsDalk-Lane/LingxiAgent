+            }};
+        }
+        let target = match gateway
+            .registry()
+            .resolve(&ToolTargetRef::ByName { name: name.into() })
+        {
+            Ok(target) => target,
+            Err(error) => refuse_child!(&unresolved, error.to_string()),
+        };
+        let listing = match gateway.registry().describe(&target) {
+            Ok(listing) => listing,
+            Err(error) => refuse_child!(&unresolved, error.to_string()),
