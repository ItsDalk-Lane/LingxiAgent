+async fn legacy_import_trace_phase(
+    args: &lingxi_adapters::storage::legacy_import::ImportArgs,
+    outcome: &lingxi_adapters::storage::legacy_import::EngineOutcome,
+) -> Result<Option<lingxi_adapters::storage::legacy_import::EngineOutcome>, String> {
+    use lingxi_adapters::storage::legacy_import as li;
+    let pending = li::pending_legacy_trace_stores(&args.target, &outcome.run_id)
+        .map_err(|e| e.to_string())?;
+    if pending.is_empty() {
+        return Ok(None);
