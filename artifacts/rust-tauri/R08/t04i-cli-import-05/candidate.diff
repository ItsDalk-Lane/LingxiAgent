+    async fn close_program_child(
+        &self,
+        db: &lingxi_adapters::storage::RunDatabase,
+        events: &EventService,
+        ctx: &lingxi_kernel::RunContext,
+        call: &ToolCallId,
+        request: &ToolRequest,
+        outcome: &ToolOutcome,
+        dispatched: bool,
+        now: u64,
+    ) -> Result<(), String> {
+        let mut receipt = journal_receipt_of(outcome);
+        receipt.dispatched = dispatched;
