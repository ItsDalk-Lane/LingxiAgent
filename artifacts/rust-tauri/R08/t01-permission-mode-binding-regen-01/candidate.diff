+    async fn close_program_child(
+        &self,
+        db: &lingxi_adapters::storage::RunDatabase,
+        events: &EventService,
+        ctx: &lingxi_kernel::RunContext,
+        call: &ToolCallId,
+        request: &ToolRequest,
+        outcome: &ToolOutcome,
+        dispatched: bool,
+        now: u64,
