+  const standardHome = standardHomes.find(home => normalizeForCompare(canonicalHome(home)) === normalizeForCompare(actualHome));
+  // 默认安装和默认开发目录延续原缓存位置；显式副本的缓存也留在副本内。
+  if (standardHome) {
