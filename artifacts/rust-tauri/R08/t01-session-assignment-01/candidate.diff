+    parent_call: ToolCallId,
+    authorization: DriveAuthorization,
+    agent_id: String,
+    phone_scoped: bool,
+    admitted_parentless_subagent: bool,
+    quota_lane: String,
+    hooks: Option<Arc<std::sync::Mutex<crate::hooks::ExtensionHooks>>>,
