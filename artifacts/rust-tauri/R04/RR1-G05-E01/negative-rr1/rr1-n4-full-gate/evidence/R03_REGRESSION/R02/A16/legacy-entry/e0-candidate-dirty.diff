+            let scenario = map
+                .scenarios
+                .iter()
+                .find(|s| s.id == id)
+                .unwrap_or_else(|| {
+                    panic!(
+                        "R04 map dropped the RR1 repair scenario {id} — the F01-F05 \
+                         adversarial-repair counterexamples would leave the formal acceptance"
+                    )
