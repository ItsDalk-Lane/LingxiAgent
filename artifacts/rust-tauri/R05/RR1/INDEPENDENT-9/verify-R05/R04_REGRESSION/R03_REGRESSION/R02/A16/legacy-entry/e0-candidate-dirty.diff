+        )
+        .expect("provider");
+        let context = ctx();
+        let input = ModelTurnInput::first_turn("read a file", one_tool_snapshot());
+
+        // Generation 1 dispatches (the declaration is present).
+        let call1 = ModelCallId::new("rr1_f01_reload_v1");
