+                .map(|s| s.to_string())
+                .map(Some)
+                .ok_or_else(|| detail_of(format!("\"workers\".{key} must be a string"))),
+        }
+    };
+    let local_name = string_field("localName", true)?.expect("required checked");
+    if local_name.is_empty()
