+                 frozen at the old generation"
+            );
+        }
+        assert!(
+            matches!(result.turn, ProviderTurn::Failed { .. }),
+            "the stale call must settle as an honest safe failure (never a silent \
+             success on mixed-generation material): {:?}",
+            result.turn
+        );
+    }
