+        release_tx.send(()).expect("release 401");
+        let result = tokio::time::timeout(Duration::from_secs(5), call_task)
+            .await
+            .expect("call settles within budget")
+            .expect("call task");
+        let _ = tokio::time::timeout(Duration::from_secs(2), task_a).await;
