+    /// `retry_backoff_base_ms` (500) — the first retry's delay.
+    pub retry_backoff_base: Duration,
+    /// `retry_backoff_cap_ms` (8 000) — the ceiling of the doubling.
+    pub retry_backoff_cap: Duration,
