+    fs::write(
+        root.join("probe-result.json"),
+        serde_json::to_vec_pretty(&report).unwrap(),
+    )
+    .unwrap();
+    assert!(
+        stable && old_detected && source_detected && replacement_rejected,
+        "{report}"
+    );
+}
