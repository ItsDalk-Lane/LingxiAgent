+fn tree_sample(pid: i32) -> serde_json::Value {
+    let ids = resource_sampler::process_ids(pid).expect("UNKNOWN: 进程树采样失败");
+    let mut processes = Vec::new();
+    let mut rss = 0;
+    let mut fds = 0;
+    let mut connections = 0;
