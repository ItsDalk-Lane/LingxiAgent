+        fds += process_fds;
+        connections += tcp.len();
+        processes.push(serde_json::json!({"pid": id, "rssKiB": process_rss, "fds": process_fds, "establishedTcp": tcp}));
+    }
+    serde_json::json!({"rootPid": pid, "rssKiB": rss, "fds": fds, "establishedTcpCount": connections, "processes": processes})
