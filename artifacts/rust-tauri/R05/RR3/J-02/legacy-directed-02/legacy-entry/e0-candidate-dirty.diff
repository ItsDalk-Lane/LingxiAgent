+        // 调用真实生产编排与真实子进程；仅被执行检查是有界控制命令。
+        let mut nested = spec(key, &["env"], &[], 60);
+        nested.argv.extend([
+            format!("LINGXI_NESTED_LEVEL={}", level + 1),
+            format!("LINGXI_NESTED_EVIDENCE={}", child_evidence.display()),
+            std::env::current_exe()
+                .unwrap()
+                .to_string_lossy()
+                .into_owned(),
