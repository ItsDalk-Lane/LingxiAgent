+            assert_eq!(point["processTree"]["establishedTcpCount"], 0);
+            points.push(point);
+            tokio::time::sleep(Duration::from_millis(100)).await;
+        }
+    }
+    state.storage().close().await.expect("owner storage close");
+    drop(state);
+    points
+}
