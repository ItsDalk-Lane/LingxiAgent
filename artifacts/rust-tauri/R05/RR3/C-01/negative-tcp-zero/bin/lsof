#!/usr/bin/env python3
import os,sys,json,pathlib
args=sys.argv[1:]
pid=args[args.index('-p')+1]
with pathlib.Path('/Users/study_superior/Desktop/Code/LingxiAgent/artifacts/rust-tauri/R05/RR3/C-01/negative-tcp-zero/calls.jsonl').open('a') as f: f.write(json.dumps({'pid':int(pid),'args':args})+'\n')
fields=args[args.index('-F')+1]
if 'tcp' == 'fd' and fields == 'fn':
 print('p'+pid)
elif 'tcp' == 'tcp' and fields == 'fpPTn':
 print('p'+pid+'\nf0\nf1\nf2')
else:
 os.execv('/usr/sbin/lsof',['/usr/sbin/lsof']+args)
