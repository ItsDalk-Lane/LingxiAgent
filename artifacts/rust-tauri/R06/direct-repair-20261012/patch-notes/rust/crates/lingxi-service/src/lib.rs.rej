+/// 最后一个服务状态所有者离开时发出停止信号，不把自持 Arc 的 worker 留活。
+struct KnowledgeWorkerOwner(Arc<knowledge::KnowledgeService>);
+impl Drop for KnowledgeWorkerOwner {
+    fn drop(&mut self) {
+        self.0.shutdown();
+    }
+}
