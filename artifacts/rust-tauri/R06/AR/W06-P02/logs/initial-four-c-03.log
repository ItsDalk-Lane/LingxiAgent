}, "tags": Object {"items": Object {"type": String("string")}, "type": String("array")}}, "type": String("object")}}, "type": String("function")}, Object {"function": Object {"description": String("tenet_propose"), "name": String("tenet_propose"), "parameters": Object {"additionalProperties": Bool(false), "properties": Object {"content": Object {"minLength": Number(1), "type": String("string")}, "priority": Object {"enum": Array [String("critical"), String("high"), String("medium"), String("low")], "type": String("string")}}, "required": Array [String("content")], "type": String("object")}}, "type": String("function")}, Object {"function": Object {"description": String("unpin_memory"), "name": String("unpin_memory"), "parameters": Object {"additionalProperties": Bool(false), "properties": Object {"id": Object {"type": String("string")}, "keyword": Object {"type": String("string")}}, "type": String("object")}}, "type": String("function")}, Object {"function": Object {"description": String("write"), "name": String("write"), "parameters": Object {"additionalProperties": Bool(false), "properties": Object {"content": Object {"type": String("string")}, "path": Object {"minLength": Number(1), "type": String("string")}}, "required": Array [String("path"), String("content")], "type": String("object")}}, "type": String("function")}, Object {"function": Object {"description": String("write_stdin"), "name": String("write_stdin"), "parameters": Object {"additionalProperties": Bool(false), "properties": Object {"chars": Object {"type": String("string")}, "process_id": Object {"minLength": Number(1), "type": String("string")}}, "required": Array [String("process_id")], "type": String("object")}}, "type": String("function")}]}]
