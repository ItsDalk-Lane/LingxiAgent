 "kind": Object {"enum": Array [String("file"), String("pasted_text")], "type": String("string")}, "name": Object {"type": String("string")}, "notebookId": Object {"type": String("string")}, "sourceId": Object {"type": String("string")}, "text": Object {"type": String("string")}}, "required": Array [String("action")], "type": String("object")}}, "type": String("function")}, Object {"function": Object {"description": String("knowledge_outline"), "name": String("knowledge_outline"), "parameters": Object {"additionalProperties": Bool(false), "properties": Object {"limit": Object {"maximum": Number(100), "minimum": Number(1), "type": String("integer")}, "notebookId": Object {"type": String("string")}, "notebookOffset": Object {"minimum": Number(0), "type": String("integer")}, "scopeId": Object {"type": String("string")}, "sectionOffset": Object {"minimum": Number(0), "type": String("integer")}, "sourceId": Object {"type": String("string")}, "sourceOffset": Object {"minimum": Number(0), "type": String("integer")}}, "required": Array [String("scopeId")], "type": String("object")}}, "type": String("function")}, Object {"function": Object {"description": String("knowledge_read"), "name": String("knowledge_read"), "parameters": Object {"additionalProperties": Bool(false), "properties": Object {"aroundChunkId": Object {"type": String("string")}, "fromOrdinal": Object {"type": String("integer")}, "maxChars": Object {"maximum": Number(8000), "minimum": Number(256), "type": String("integer")}, "neighborWindow": Object {"maximum": Number(3), "minimum": Number(0), "type": String("integer")}, "notebookId": Object {"type": String("string")}, "offset": Object {"minimum": Number(0), "type": String("integer")}, "query": Object {"type": String("string")}, "scopeId": Object {"type": String("string")}, "sectionId": Object {"type": String("string")}, "sourceId": Object {"type": String("string")}, "toOrdinal": Object {"type": String("integer")}}, "required": Array [String("scopeId"), String