+#[tokio::test]
+async fn f01_child_inherits_authorized_material_only() {
+    use lingxi_service::subagents::{ParentRunFacts, SubagentLauncher};
+    use lingxi_service::{
+        prepare_layout, HomeSource, NetworkMode, ServiceConfig, ServiceDeps, ServiceState,
+    };
