+struct Booted {
+    state: ServiceState,
+    provider: Arc<RecordingProvider>,
+    home: PathBuf,
+    /// 规范化后的数据根（macOS 上 /var 会被规范到 /private/var）——材料
+    /// 覆写必须落在这里。
