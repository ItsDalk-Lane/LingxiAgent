+fn c04_incumbent_sample_defaults_and_unknown_fields_survive_updates() {
+    use lingxi_adapters::storage::agent_memory::{
+        config::AgentConfigDocument, patch_agent_config, AgentConfigFlags, AgentConfigPatch,
+    };
