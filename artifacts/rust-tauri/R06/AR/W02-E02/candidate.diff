+    assert_eq!(std::fs::read(&file).unwrap(), b"B");
+    assert_eq!(
+        std::fs::read(&original_state).unwrap(),
+        original_state_bytes
+    );
+    println!("source_directory_link rejected=true target=B external_state_unchanged=true");
+    server.stop_and_clean().await;
+}
