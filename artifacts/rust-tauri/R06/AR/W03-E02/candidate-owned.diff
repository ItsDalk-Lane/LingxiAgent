+                    self.foreign
+                        .write(
+                            &serde_json::json!({"kind":"local-file","path":self.foreign_path}),
+                            b"forbidden".to_vec(),
+                            &op
+                        )
+                        .await
+                        .unwrap_err()
+                        .status,
+                    409
+                );
+                assert!(!self.foreign_path.exists());
+                let result = self
+                    .io
+                    .write(
+                        &serde_json::json!({"kind":"local-file","path":self.path}),
