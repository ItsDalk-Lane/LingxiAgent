+    waiter.abort();
+    let _ = waiter.await;
+    let still_busy = svc
+        .post(
+            "/lingxi/v1/sessions/sess_local_alpha/fork",
+            serde_json::json!({"newSessionId":"during-cancel","boundaryMessageId":boundary}),
+        )
