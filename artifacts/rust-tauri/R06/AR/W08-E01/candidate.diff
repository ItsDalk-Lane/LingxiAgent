 fn text_of(content: &[ContentBlock]) -> String {
     content
         .iter()
         .filter_map(|block| match block {
-            ContentBlock::Text { text } => Some(text.as_str()),
+            ContentBlock::Text { text } | ContentBlock::Reasoning { text } => Some(text.as_str()),
             _ => None,
         })
         .collect::<Vec<_>>()
