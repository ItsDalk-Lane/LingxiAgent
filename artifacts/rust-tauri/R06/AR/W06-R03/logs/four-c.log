(0), "type": String("integer")}}, "required": Array [String("scopeId")], "type": String("object")}}, "type": String("function")}, Object {"function": Object {"description": String("knowledge_read"), "name": String("knowledge_read"), "parameters": Object {"additionalProperties": Bool(false), "properties": Object {"aroundChunkId": Object {"type": String("string")}, "fromOrdinal": Object {"type": String("integer")}, "maxChars": Object {"maximum": Number(8000), "minimum": Number(256), "type": String("integer")}, "neighborWindow": Object {"maximum": Number(3), "minimum": Number(0), "type": String("integer")}, "notebookId": Object {"type": String("string")}, "offset": Object {"minimum": Number(0), "type": String("integer")}, "query": Object {"type": String("string")}, "scopeId": Object {"type": String("string")}, "sectionId": Object {"type": String("string")}, "sourceId": Object {"type": String("string")}, "toOrdinal": Object {"type": String("integer")}}, "required": Array [String("scopeId"), String("sourceId")], "type": String("object")}}, "type": String("function")}, Object {"function": Object {"description": String("knowledge_search"), "name": String("knowledge_search"), "parameters": Object {"additionalProperties": Bool(false), "properties": Object {"channel": Object {"enum": Array [String("fts"), String("hybrid")], "type": String("string")}, "limit": Object {"type": String("number")}, "notebookIds": Object {"items": Object {"type": String("string")}, "type": String("array")}, "query": Object {"type": String("string")}, "scopeId": Object {"type": String("string")}, "sectionKeys": Object {"items": Object {"type": String("string")}, "type": String("array")}, "sourceIds": Object {"items": Object {"type": String("string")}, "type": String("array")}}, "required": Array [String("scopeId"), String("query")], "type": String("object")}}, "type": String("function")}, Object {"function": Object {"description": String("pin_memory"), "name": String("pin_memory"), "parameters": Object {"additionalProperties": Bool(false), "properties": Object {"content": Object {"minLength": Number(1), "type": String("string")}}, "required": Array [String("content")], "type": String("object")}}, "type": String("function")}, Object {"function": Object {"description": String("read"), "name": String("read"), "parameters": Object {"additionalProperties": Bool(false), "properties": Object {"limit": Object {"minimum": Number(1), "type": String("integer")}, "offset": Object {"minimum": Number(1), "type": String("integer")}, "path": Object {"minLength": Number(1), "type": String("string")}}, "required": Array [String("path")], "type": String("object")}}, "type": String("function")}, Object {"function": Object {"description": String("search_memory"), "name": String("search_memory"), "parameters": Object {"additionalProperties": Bool(false), "properties": Object {"date_from": Object {"type": String("string")}, "date_to": Object {"type": String("string")}, "query": Object {"type": String("string")}, "tags": Object {"items": Object {"type": String("string")}, "type": String("array")}}, "type": String("object")}}, "type": String("function")}, Object {"function": Object {"description": String("tenet_propose"), "name": String("tenet_propose"), "parameters": Object {"additionalProperties": Bool(false), "properties": Object {"content": Object {"minLength": Number(1), "type": String("string")}, "priority": Object {"enum": Array [String("critical"), String("high"), String("medium"), String("low")], "type": String("string")}}, "required": Array [String("content")], "type": String("object")}}, "type": String("function")}, Object {"function": Object {"description": String("unpin_memory"), "name": String("unpin_memory"), "parameters": Object {"additionalProperties": Bool(false), "properties": Object {"id": Object {"type": String("string")}, "keyword": Object {"type": String("string")}}, "type": String("object")}}, "type": String("function")}, Object {"function": Object {"description": String("write"), "name": String("write"), "parameters": Object {"additionalProperties": Bool(false), "properties": Object {"content": Object {"type": String("string")}, "path": Object {"minLength": Number(1), "type": String("string")}}, "required": Array [String("path"), String("content")], "type": String("object")}}, "type": String("function")}, Object {"function": Object {"description": String("write_stdin"), "name": String("write_stdin"), "parameters": Object {"additionalProperties": Bool(false), "properties": Object {"chars": Object {"type": String("string")}, "process_id": Object {"minLength": Number(1), "type": String("string")}}, "required": Array [String("process_id")], "type": String("object")}}, "type": String("function")}]}] matched=true
