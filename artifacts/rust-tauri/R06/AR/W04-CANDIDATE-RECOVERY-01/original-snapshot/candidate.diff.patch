+/// 运行期的真实活动单调前进；历史导入的原 upsert 接口保留显式历史时刻。
+pub async fn record_current_activity(
+    db: &RunDatabase,
+    session_id: &str,
+    now: u64,
+) -> Result<(), StorageError> {
+    let sid = session_id.to_string();
