+                        "knowledge cache has multiple hard links",
+                    ));
+                }
+            }
+            Ok(Some(meta))
+        }
+        Err(e) if e.kind() == std::io::ErrorKind::NotFound => Ok(None),
+        Err(e) => Err(storage_io(e)),
