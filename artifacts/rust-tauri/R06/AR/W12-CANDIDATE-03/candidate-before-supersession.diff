+            facts_before
+        );
+        assert_eq!(
+            std::fs::read(root.join(&source_snapshot.storage_path)).unwrap(),
+            source_before
+        );
+        assert_eq!(std::fs::read(root.join(other)).unwrap(), other_before);
+        open_cache(&root, name).expect("重启后正常");
