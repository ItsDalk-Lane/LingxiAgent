+            )
+            .unwrap();
+        drop(facts);
+        open_cache(&root, "knowledge_index.db").unwrap();
+        let vectors = KnowledgeVectorStore::open(&root).unwrap();
+        let build = vectors
+            .begin_variant_build(
+                "civ-unique",
+                "artifact-unique",
+                "paid-model",
+                "fingerprint",
