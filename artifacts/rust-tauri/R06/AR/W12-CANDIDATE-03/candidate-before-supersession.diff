+            )
+            .unwrap();
+        vectors
+            .upsert_batch(
+                &build.variant_id,
+                &[lingxi_adapters::storage::knowledge::VectorEntry {
+                    chunk_id: "chunk".into(),
+                    ordinal: 0,
+                    vector: vec![0.2, 0.8],
+                }],
+            )
+            .unwrap();
+        vectors.complete_build(&build.variant_id, 1).unwrap();
