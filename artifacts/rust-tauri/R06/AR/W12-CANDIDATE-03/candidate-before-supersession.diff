+fn quarantine_originals(root: &std::path::Path) -> Vec<PathBuf> {
+    std::fs::read_dir(root)
+        .unwrap()
+        .filter_map(|entry| {
+            let path = entry.unwrap().path();
+            path.file_name()
+                .unwrap()
+                .to_string_lossy()
+                .contains(".quarantine-")
+                .then(|| path.join("original.db"))
+        })
+        .collect()
+}
