+    let child_gate = Arc::new(tokio::sync::Semaphore::new(0));
+    let provider = scripted(
+        vec![
+            (
+                "CAP-A",
+                vec![
+                    call("subagent", json!({"task":"HELD-A: first"})),
+                    call("subagent", json!({"task":"SHOULD-NOT-A: session cap"})),
+                    Step::Final("session cap refusal"),
+                ],
+            ),
+            ("HELD-A", vec![Step::Final("real result A")]),
+            (
+                "CAP-B",
+                vec![
+                    call("subagent", json!({"task":"HELD-B: second"})),
+                    Step::Final("launched B"),
+                ],
+            ),
+            ("HELD-B", vec![Step::Final("real result B")]),
+            (
+                "CAP-GLOBAL-REFUSE",
+                vec![
+                    call("subagent", json!({"task":"SHOULD-NOT-GLOBAL: global cap"})),
+                    Step::Final("global cap refusal"),
+                ],
+            ),
+            (
+                "CAP-RECOVER",
+                vec![
+                    call(
+                        "subagent",
+                        json!({"task":"RECOVERED-CHILD: actual accepted"}),
+                    ),
+                    Step::Final("recovered"),
+                ],
+            ),
+            (
+                "RECOVERED-CHILD",
+                vec![Step::Final("true recovered result")],
+            ),
+        ],
+        vec![
+            (("HELD-A", 1), child_gate.clone()),
+            (("HELD-B", 1), child_gate.clone()),
+        ],
+    );
+    let fx = Fixture::start(
+        "subagent-cap-matrix",
+        ServiceDeps {
+            turn_provider: Some(provider.clone()),
+            tool_gateway: Some(delegation_gateway()),
+            subagent_policy: lingxi_kernel::subagent::SubagentPolicy {
+                per_session_limit: 1,
+                global_limit: 2,
+                ..Default::default()
+            },
+            ..ServiceDeps::default()
+        },
+    )
+    .await;
+    let token = fx.state.auth().local_token();
+    create_owned_session(&fx, "cap-third-parent", "operate").await;
+    let cap_parent = execute_actual(
+        fx.addr,
+        &token,
+        "sess_local_alpha",
+        "CAP-A: launch then refuse second in same parent",
+    )
+    .await;
+    wait_until(|| {
+        provider
+            .calls
+            .lock()
+            .unwrap()
+            .iter()
+            .any(|(m, _)| m == "HELD-A")
+    })
+    .await;
+    let cap_outcomes = parent_tool_outcomes(&provider, "CAP-A", &cap_parent);
+    assert_eq!(cap_outcomes.len(), 2);
+    assert!(matches!(&cap_outcomes[0], ToolOutcome::Success { .. }));
+    assert!(
+        matches!(&cap_outcomes[1],ToolOutcome::Failed{error} if error.code==ErrorCode::BudgetExceeded && error.message.contains("per-session"))
+    );
+    assert_eq!(fx.child_count("sess_local_alpha").await, "1");
+    assert_eq!(
+        fx.state.subagents().active_counts("sess_local_alpha"),
+        (1, 1)
+    );
+    execute_actual(fx.addr, &token, "sess_local_beta", "CAP-B: launch second").await;
+    wait_until(|| {
+        provider
+            .calls
+            .lock()
+            .unwrap()
+            .iter()
+            .any(|(m, _)| m == "HELD-B")
+    })
+    .await;
+    let global_refused = execute_actual(
+        fx.addr,
+        &token,
+        "cap-third-parent",
+        "CAP-GLOBAL-REFUSE: no third child",
+    )
+    .await;
+    assert!(
+        matches!(&parent_tool_outcomes(&provider,"CAP-GLOBAL-REFUSE",&global_refused)[0],ToolOutcome::Failed{error} if error.code==ErrorCode::BudgetExceeded && error.message.contains("global"))
+    );
+    assert_eq!(fx.child_count("cap-third-parent").await, "0");
+    assert_eq!(
+        fx.state.subagents().active_counts("cap-third-parent"),
+        (0, 2)
+    );
+    assert!(!provider
+        .calls
+        .lock()
+        .unwrap()
+        .iter()
+        .any(|(m, _)| matches!(m.as_str(), "SHOULD-NOT-A" | "SHOULD-NOT-GLOBAL")));
+    child_gate.add_permits(2);
+    wait_until(|| fx.state.subagents().active_counts("sess_local_alpha") == (0, 0)).await;
+    execute_actual(
+        fx.addr,
+        &token,
+        "cap-third-parent",
+        "CAP-RECOVER: capacity reusable",
+    )
+    .await;
+    wait_until(|| fx.state.subagents().active_counts("cap-third-parent") == (0, 0)).await;
+    assert_eq!(fx.child_count("cap-third-parent").await, "1");
+    assert_eq!(fx.child_count("sess_local_alpha").await, "1");
+    assert_eq!(fx.child_count("sess_local_beta").await, "1");
     fx.finish().await;
 }
 
