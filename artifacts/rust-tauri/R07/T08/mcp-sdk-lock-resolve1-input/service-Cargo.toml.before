[package]
name = "lingxi-service"
description = "Rust independent service / composition root (R02-T01): process entrypoint, explicit configuration, transport wiring and port injection. The domain (lingxi-kernel) never reaches HTTP/UI/env/database directly - implementations are injected here as R02 storage/event tasks land them."
version = "0.0.0"
edition.workspace = true
license.workspace = true
publish.workspace = true

# R02-T01: every third-party crate below is already a locked member of the
# workspace dependency tree (introduced by R01-T02/T03 for lingxi-protocol /
# lingxi-spike); no new third-party version enters rust/Cargo.lock with this
# crate. Exact versions: axum 0.8.9, tokio 1.53.1, serde 1.0.229,
# serde_json 1.0.151, tracing 0.1.44, tracing-subscriber 0.3.23
# (docs/rust-tauri/R01/DEPENDENCY_DECISIONS.md total lock table).
#
# Deliberately NOT a dependency at R02-T01:
#   - lingxi-kernel: no port implementation exists yet (storage is R02-T04,
#     events R02-T05, auth R02-T03). An unused edge would be a fake
#     "composition" - the edge is added by the first task that actually
#     injects a port implementation.
#   - reqwest / rusqlite: no outbound HTTP and no database access at T01.
[dependencies]
# 仅成熟的本地解析器；精确版本随知识处理产物身份固定。
pdf-extract = "=0.12.1"
csv = "=1.4.0"
scraper = { version = "=0.27.0", default-features = false }
axum = { workspace = true }
zip = { workspace = true }
# Office 只解析受限内存中的 XML，不展开外部实体或写出归档成员。
quick-xml = { workspace = true }
lingxi-protocol = { path = "../lingxi-protocol" }
# R07-T08：仅官方 MCP 3.4.1 协议/授权与 Streamable HTTP；HTTP 客户端由共享 NetworkPlane 提供。
# OAuth、SSE事件解析及受监督 worker 随官方 feature 进入锁，不实现旧独立 SSE 协议。
rmcp = { version = "=3.4.1", default-features = false, features = ["client", "server", "auth", "transport-streamable-http-client-reqwest"] }
async-trait = "=0.1.89"
sse-stream = "=0.2.4"
serde = { version = "1.0.229", features = ["derive"] }
serde_json = "1.0.151"
# 办公 frontmatter 复用 adapters 已锁定的 YAML 实现，不新增包版本。
serde_yaml_ng = "=0.10.0"
# R07-T07-δ8（设计登记 docs/rust-tauri/R07/T07_STATUS.md δ8）：工作流 JS 沙箱
# 引擎。boa_engine 0.20 是纯 Rust ECMAScript 实现，符合依赖选型先例
# （quick-xml/zip-zlib-rs/jieba 同档）；v8/deno_core 过重、rquickjs 引 C 均不取。
# 本任务是 R02-T01 以来首次向 Cargo.lock 引入新第三方包族（boa_engine 及其
# 传递依赖），选型与探针验证（/private/tmp/boa-probe 4/4）已在 δ8 设计节登记。
# default-features=false：不启用 boa 的 deser/flowgraph/temporal 等非必需特性，
# 沙箱只用核心 Context/Value/NativeFunction 与 job queue 钩子。
boa_engine = { version = "=0.20.0", default-features = false }
# boa 定制 job queue 的 FuturesUnordered（FutureJob !Send，current_thread 驱动）。
# futures 0.3.34 已在工作区锁内（rmcp 传递依赖），只加边不增版本。
futures = "0.3.34"
# R04-T05: the "process" feature is added for tokio::process::Command
# (async spawn/wait of the supervised children). Feature flags only —
# tokio 1.53.1 and all its deps (bytes/libc/mio/...) are already locked;
# no new package version enters rust/Cargo.lock (the serde_json R04-T01
# precedent for lock-reuse).
tokio = { version = "1.53.1", features = ["macros", "rt-multi-thread", "net", "signal", "io-util", "time", "sync", "process"] }
tracing = "0.1.44"
tracing-subscriber = { version = "0.3.23", features = ["fmt", "env-filter"] }
# R02-T03 additions — every crate below is ALREADY a locked member of the
# workspace dependency tree at exactly this version (no new third-party
# version enters rust/Cargo.lock with this task; the lock only gains
# dependency references for this crate):
#   - hyper 1.11.1: axum's own HTTP implementation, needed to name
#     hyper::upgrade::OnUpgrade for the WebSocket upgrade path (axum's `ws`
#     feature is deliberately NOT enabled — it would pull the unlocked
#     tokio-tungstenite/tungstenite pair into Cargo.lock).
#   - sha1 0.11.0 / base64 0.23.1: RFC 6455 Sec-WebSocket-Accept computation
#     (the same roles they already serve in lingxi-protocol's handshake bins).
#   - sha2 0.11.0: fixed-length digests so token comparison is length-safe
#     and constant-time (hash-then-compare).
# R02 stage-repair R2 (R2-F04): features made explicit — the transport
# serving loop (src/serve.rs) names hyper's server builder,
# TowerToHyperService and rt adapters directly. Every crate and version is
# ALREADY in rust/Cargo.lock (h2 0.4.19, tower 0.5.3 included — pulled by
# axum/hyper since R01); feature flags and references change nothing in
# the lock.
hyper = { version = "1.11.1", default-features = false, features = ["http1", "server"] }
sha1 = "0.11.0"
sha2 = "0.11.0"
base64 = "0.23.1"
#   - hyper-util 0.1.21 (axum's own runtime glue, same locked version):
#     TokioIo adapts hyper's upgraded connection IO to tokio's
#     AsyncRead/AsyncWrite for the WS frame codec; service +
#     http1 serve the connection-level admission loop (R2-F04). R3-F01:
#     the serving loop uses hyper's EXPLICIT http1 builder, so the
#     "server"/"server-auto" features (hyper-util's auto version-sniffing
#     server) are no longer enabled — the untimed ReadVersion state they
#     provided was the defect.
hyper-util = { version = "0.1.21", default-features = false, features = ["tokio", "http1", "service"] }
tower = "0.5.3"
rustls = "0.23.45"
tokio-rustls = "0.26.5"
scrypt = "=0.12.0"
chrono = "=0.4.45"
# R9-F05: getrandom 0.2.17 is ALREADY a locked member of the workspace tree
# (pulled transitively by other crates); this edge adds no new version to
# rust/Cargo.lock. It is the SYSTEM secure random source for every auth
# credential (loopback token, device secret/salt, WS tickets): the old
# hand-rolled reader silently degraded non-Unix builds — and any
# /dev/urandom failure — to a predictable pid+time xorshift; the system
# CSPRNG propagates its failures so credential issuance can REFUSE
# (src/auth.rs).
getrandom = "0.2"
# R06-T05: HMAC-SHA256 for the resource-content ticket signer
# (core/resource-ticket-service.ts signBody). hmac 0.13.0 is ALREADY a
# locked workspace member (transitive); this edge reuses that exact
# version — no new package version enters rust/Cargo.lock (D11).
hmac = "0.13.0"
# R06-T05 Round 5（D11 延展，同一纪律：全部为已锁定包版本，只加边）：
#   - regex 1.13.1：html-preview.ts 的素材引用改写/<head> 注入正则
#     （src|href|poster 属性扫描与 (?i)<head\b[^>]*>）。
#   - percent-encoding 2.3.2：JS encodeURIComponent/decodeURIComponent/
#     decodeURI 语义的逐段编码与保留集（preview 素材 URL 与桥媒体
#     filename* RFC5987）。
regex = "1.13.1"
percent-encoding = "2.3.2"
# R00 手机访问二维码：qrcodegen 1.8.0（MIT，无传递依赖）只生成标准 QR 模块；SVG 由本服务绘制。
qrcodegen = "=1.8.0"
libc = "0.2"
# 各平台统一枚举实际网卡，供局域网地址与二维码选择使用。
if-addrs = "=0.15.0"
# R02-T04 additions — both are workspace members, zero third-party change:
#   - lingxi-kernel: the StoragePort contract this composition root now
#     injects (R02-T01 deliberately deferred the edge until a port
#     implementation existed to inject).
#   - lingxi-adapters: the SQLite-backed StoragePort implementation (new
#     run/message database behind a bounded single-writer queue).
lingxi-kernel = { path = "../lingxi-kernel" }
lingxi-adapters = { path = "../lingxi-adapters" }
# R02-T05 note: the event subscription service (src/events.rs) additionally
# uses tokio's "sync" feature (Notify behind the bounded subscriber
# mailboxes); same locked tokio version, feature flag only — no new lock
# entries beyond this crate's existing references.

# N06：Windows 安全审计日志逐层使用目录句柄相对打开，拒绝重解析点。
# 版本已经存在于工作区锁文件；仅 Windows 目标需要 Native/Win32 声明。

# 资源 URL 读取沿用适配器已经锁定的 HTTP 客户端，不新增包版本。
reqwest = { version = "0.13.5", features = ["json", "form", "socks"] }

[target.'cfg(windows)'.dependencies]
windows-sys = { version = "=0.61.2", features = ["Wdk_Foundation", "Wdk_Storage_FileSystem", "Win32_Foundation", "Win32_Security", "Win32_Security_Authorization", "Win32_Storage_FileSystem", "Win32_System_IO", "Win32_System_Threading", "Win32_System_WindowsProgramming"] }

#
# R02-T06 dev-only: rusqlite at the SAME locked version + bundled feature as
# lingxi-adapters (zero new lock entries). Used exclusively by the shutdown
# coordinator tests to hold a REAL external WAL write lock while proving the
# deadline bounds a blocked DB close.
[dev-dependencies]
# 自有 HTTP 外端同样使用官方服务传输，不手写 MCP 协议。
rmcp = { version = "=3.4.1", default-features = false, features = ["transport-streamable-http-server"] }
rusqlite = { version = "0.40.2", features = ["bundled"] }
# 测试时临时生成证书/密钥，仓库和证据中均不保存私钥。
rcgen = "=0.14.10"
# R04-T05 integration tests probe real process liveness (kill(pid, 0))
# for the managed tree and the unrelated sentinel. Same locked libc
# version as the [dependencies] edge — zero new lock entries.
libc = "0.2"
# R06-T06: every test binary of this crate links kernel; enabling the
# guard feature on this dev-dependency edge force-links the test guard's
# pre-main hook into all of them (unit tests + tests/*.rs + the bins built
# for CARGO_BIN_EXE_* tests). Never active for `cargo build` / release.
lingxi-kernel = { path = "../lingxi-kernel", features = ["test-guard"] }
# R06-T06: direct dev-dependency for the test binaries that link no crate
# code at all (spawn-only wiring tests, bin test harnesses) — those carry
# an explicit `use lingxi_test_guard as _;` so the pre-main hook is
# force-linked there too. Dev-only.
lingxi-test-guard = { path = "../lingxi-test-guard" }
