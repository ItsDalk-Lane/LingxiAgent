{
  "models": {
    "chat": {
      "model": "chat-only",
      "provider": "fixture"
    },
    "speech": {
      "model": "seed-speech",
      "provider": "fixture"
    }
  },
  "network": {
    "proxy": {
      "mode": "direct"
    }
  },
  "providers": {
    "fixture": {
      "auth": {
        "apiKey": "synthetic-media-key",
        "kind": "apiKey"
      },
      "endpoint": "http://127.0.0.1:55052",
      "models": [
        {
          "context": 8192,
          "id": "chat-only",
          "input": [
            "text"
          ]
        },
        {
          "id": "seed-speech",
          "outputs": [
            "audio"
          ],
          "protocol": "openai-audio-speech",
          "unknownKeep": {
            "nested": true
          }
        },
        {
          "api": "openai-audio-speech",
          "customField": {
            "keep": true
          },
          "displayName": "speech改名",
          "id": "new-speech",
          "mediaCapability": "speech_generation",
          "protocol": "openai-audio-speech",
          "protocolId": "openai-audio-speech"
        }
      ],
      "protocol": "openai-completions"
    }
  }
}