{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lingxi Resources",
  "version": "0.0.0",
  "identifier": "dev.lingxi.resources",
  "build": {
    "frontendDist": "../dist-tauri-resources"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "灵犀 · 文件",
        "width": 1000,
        "height": 760,
        "url": "index.html",
        "devtools": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data: asset: http://asset.localhost; media-src 'self' data: blob: asset: http://asset.localhost; frame-src 'self' blob:; object-src 'none'",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/.lingxi/**",
          "$HOME/.lingxi-dev/**",
          "$HOME/.hanako-dev/**",
          "$TEMP/**"
        ]
      }
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.png"
    ]
  }
}
