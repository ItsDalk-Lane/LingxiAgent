{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lingxi",
  "version": "0.0.0",
  "identifier": "com.lingxi.app",
  "build": {
    "frontendDist": "../dist-renderer"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* ws://127.0.0.1:*; img-src 'self' data: blob: asset: http://asset.localhost http://127.0.0.1:*; media-src 'self' data: blob: asset: http://asset.localhost http://127.0.0.1:*; font-src 'self' data:; frame-src 'self' blob:; object-src 'none'; base-uri 'none'; form-action 'none'",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/.lingxi/**",
          "$HOME/.lingxi-dev/**",
          "$HOME/.hanako-dev/**",
          "$TEMP/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/icon.png"
    ],
    "externalBin": [
      "binaries/lingxi-service"
    ],
    "resources": {
      "resources/rust-service/build.json": "rust-service/build.json",
      "../../release-digest.v1.json": "release-digest.v1.json",
      "../../release-digest.v2.json": "release-digest.v2.json",
      "resources/chromium": "chromium",
      "resources/node": "node",
      "resources/workers": "workers",
      "resources/office": "office",
      "resources/bin/ast-grep": "bin/ast-grep",
      "resources/lsp": "lsp"
    },
    "macOS": {
      "signingIdentity": "-",
      "infoPlist": "Info.plist"
    }
  }
}
