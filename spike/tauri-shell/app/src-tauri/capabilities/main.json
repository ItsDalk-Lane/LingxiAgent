{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-capability",
  "description": "可信主窗口授权面：核心默认 + 业务命令 + 本 spike 实测所需的插件权限。前端无任何 shell/execute 权限。",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:webview:default",
    "core:event:default",
    "allow-shell-public-info",
    "allow-shell-sensitive-probe",
    "allow-sidecar-status",
    "allow-sidecar-ping",
    "allow-sidecar-restart",
    "allow-finish-e2e",
    "notification:default",
    "notification:allow-notify",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message",
    "clipboard-manager:default",
    "clipboard-manager:allow-write-text",
    "clipboard-manager:allow-read-text",
    "global-shortcut:default",
    "autostart:default",
    "updater:default",
    "process:default"
  ]
}
