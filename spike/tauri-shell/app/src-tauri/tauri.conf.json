{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "lingxi-t06-shell-spike",
  "version": "0.1.0",
  "identifier": "dev.lingxi.t06.spike",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "lingxi-t06-spike main (trusted)",
        "width": 900,
        "height": 640,
        "visible": false,
        "url": "index.html"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:19274; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "externalBin": ["binaries/lingxi-t06-sidecar"],
    "macOS": {
      "entitlements": null,
      "infoPlist": "Info.plist"
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENBRTQwQzkyRTZBNURCRApSV1M5WFdvdXlVQ3VESTJaakNlaThPZE03U21qTm0rRWd0TzM3ZE4yYUJDWkNNYmFhVWxqbGhSSgo=",
      "endpoints": ["http://127.0.0.1:19274/updates/latest.json"],
      "dangerousInsecureTransportProtocol": true
    }
  }
}
