  "stackingWindows": {
    "main": {
      "minCapabilities": 2,
      "reason": "A11/OQ-10 要求显式构造同一 webview 命中多条 capability 的叠加场景；main 至少命中 baseline+资源两条，展开并集必须等于本策略。"
    }
  },
