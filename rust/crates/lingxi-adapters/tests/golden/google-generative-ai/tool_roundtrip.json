    "usageMetadata": {"promptTokenCount": 410, "candidatesTokenCount": 12}
  },
  "expected_turn": {
    "kind": "final",
    "content": [{"text": "全部处理完毕。"}],
    "usage": {"input_tokens": 410, "output_tokens": 12}
