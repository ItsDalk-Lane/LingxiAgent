{
  "name": "lingxi",
  "version": "0.1.43",
  "lingxi": {
    "upstreamVersion": "0.447.4",
    "releaseGeneration": 21
  },
  "type": "module",
  "description": "Lingxi - a personal AI agent with memory and soul",
  "license": "Apache-2.0",
  "author": {
    "name": "Lingxi"
  },
  "keywords": [
    "ai-agent",
    "electron",
    "memory",
    "multi-platform",
    "telegram",
    "personal-assistant"
  ],
  "engines": {
    "node": ">=24.12.0 <25"
  },
  "scripts": {
    "dev:web": "node scripts/dev-web.js",
    "dev:renderer": "vite --config vite.config.ts",
    "build:renderer": "vite build --config vite.config.ts",
    "build:splash": "vite build --config vite.config.splash.ts",
    "build:theme": "vite build --config vite.config.theme.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.test.json",
    "build:rust-service": "node scripts/build-rust-desktop-service.mjs",
    "verify:rust-service-package": "node scripts/build-rust-desktop-service.mjs --verify",
    "build:tauri:renderer": "npm run build:renderer && npm run build:theme",
    "build:tauri:service": "npm run build:rust-service",
    "build:tauri": "npm run fetch:chromium && npm run fetch:node && npm run fetch:lsp && node scripts/tauri-build.mjs",
    "build:tauri:debug": "node scripts/tauri-build.mjs --debug",
    "dev:tauri": "node scripts/tauri-dev.mjs",
    "fetch:bundled-bins": "node scripts/fetch-bundled-binaries.cjs",
    "fetch:chromium": "node scripts/fetch-chromium.cjs",
    "test": "vitest run --exclude '**/.claude/**' --exclude '**/.cache/**' --exclude '**/dist/**' --exclude '**/dist-server/**' --exclude '**/dist-computer-use/**' --exclude '**/dist-sandbox/**'",
    "lint": "eslint .",
    "test:watch": "vitest --exclude '**/.claude/**' --exclude '**/.cache/**' --exclude '**/dist/**' --exclude '**/dist-server/**' --exclude '**/dist-computer-use/**' --exclude '**/dist-sandbox/**'",
    "fetch:node": "node scripts/fetch-node-runtime.cjs",
    "stage:tauri:workers": "node scripts/stage-tauri-workers.mjs",
    "fetch:lsp": "node scripts/fetch-lsp-servers.cjs"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/view": "6.43.0",
    "@firecrawl/anydoc": "0.1.2",
    "@hono/node-server": "^1.19.17",
    "@hono/node-ws": "^1.3.0",
    "@larksuiteoapi/node-sdk": "^1.72.0",
    "@node-rs/jieba": "2.0.1",
    "@silvia-odwyer/photon-node": "0.3.4",
    "@tanstack/react-virtual": "3.14.10",
    "@tiptap/core": "^3.22.0",
    "@tiptap/extension-bold": "^3.22.0",
    "@tiptap/extension-placeholder": "^3.22.0",
    "@tiptap/pm": "^3.22.0",
    "@tiptap/react": "^3.22.0",
    "@tiptap/starter-kit": "^3.22.0",
    "@traptitech/markdown-it-katex": "^3.6.0",
    "ansi_up": "6.0.6",
    "better-sqlite3": "^12.6.2",
    "chokidar": "^5.0.0",
    "codemirror": "^6.0.2",
    "diff": "8.0.4",
    "exceljs": "^4.4.0",
    "hono": "^4.13.1",
    "js-yaml": "^4.3.1",
    "jsdom": "^29.0.2",
    "katex": "^0.16.39",
    "mammoth": "^1.11.0",
    "markdown-it": "^14.3.0",
    "markdown-it-task-lists": "^2.1.1",
    "mermaid": "11.16.1",
    "motion": "12.40.0",
    "node-pty": "1.1.0",
    "node-telegram-bot-api": "^0.67.0",
    "proxy-agent": "6.5.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "semver": "7.8.0",
    "typebox": "1.1.38",
    "undici": "7.29.0",
    "unpdf": "1.6.2",
    "ws": "^8.18.0",
    "yauzl": "3.4.0",
    "zustand": "^5.0.11"
  },
  "overrides": {
    "form-data": "^4.0.0",
    "qs": "^6.14.1",
    "tough-cookie": "^4.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tauri-apps/cli": "2.12.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/markdown-it": "^14.1.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/yauzl": "3.4.0",
    "@vercel/nft": "^1.5.0",
    "@vitejs/plugin-react": "^5.1.4",
    "esbuild": "^0.27.4",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "node-gyp": "12.4.0",
    "pngjs": "^5.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.2",
    "vite": "^7.3.6",
    "vitest": "^4.1.10",
    "electron": "42.8.1",
    "electron-updater": "^6.8.9"
  },
  "optionalDependencies": {
    "usearch": "2.26.0"
  }
}
